@startuml
' OnlyPlans — Use Case diagram (v4)
' Роли: Владелец (полный контроль), Редактор (Продакт, Тимлид, БА) — создают и редактируют план;
' Читатель (стейкхолдеры, руководство, сотрудники) — view-only. См. docs/ba/02-user-stories.md
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
' Ровные ортогональные линии вместо диагоналей — понятнее, к какому юзкейсу ведёт стрелка
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 90

actor "Владелец" as OWN
actor "Редактор\n(Продакт, Тимлид, БА)" as ED
actor "Читатель\n(стейкхолдер, сотрудник)" as STK

rectangle "OnlyPlans" {

  ' Discovery
  usecase "UC-1 Создать фичу/исследование" as U1
  usecase "UC-2 Настроить состав работ" as U2
  usecase "UC-3 Отследить статусы" as U3

  ' Delivery / планирование
  usecase "UC-4 Спланировать неделю" as U4
  usecase "UC-5 Передвинуть задачу по статусам" as U5
  usecase "UC-7 Настроить пресеты длительностей" as U7

  ' Календарь
  usecase "UC-6a Просмотреть календарный вид" as U6a
  usecase "UC-6b Настроить календарный вид" as U6b

  ' Свимлайны
  usecase "UC-9 Настроить свимлайны по типам" as U9

  ' Нагрузка
  usecase "UC-10 Управлять нагрузкой" as U10

  ' Таймлайн
  usecase "UC-11 Просмотреть таймлайн с вехами" as U11

  ' Поиск
  usecase "UC-12 Искать и фильтровать" as U12

  ' Комментарии
  usecase "UC-13 Оставлять комментарии и видеть историю" as U13

  ' Просмотр
  usecase "UC-8 Просмотреть роадмап (view-only)" as U8

  ' Зависимости
  usecase "UC-14 Связывать зависимости" as U14

  ' Связи между юзкейсами
  U1 ..> U2 : включает (состав работ)
  U4 ..> U7 : включает (пресеты)
  U6b ..> U6a : использует
}

' Владелец: полный контроль (+ всё, что редактор)
OWN --> U1
OWN --> U2
OWN --> U3
OWN --> U4
OWN --> U5
OWN --> U6a
OWN --> U6b
OWN --> U7
OWN --> U8
OWN --> U9
OWN --> U10
OWN --> U11
OWN --> U12
OWN --> U13
OWN --> U14

' Редактор: создаёт и редактирует план (полный CRUD)
ED --> U1
ED --> U2
ED --> U3
ED --> U4
ED --> U5
ED --> U6a
ED --> U6b
ED --> U7
ED --> U8
ED --> U9
ED --> U10
ED --> U11
ED --> U12
ED --> U13
ED --> U14

' Читатель: view-only (+ сотрудник обновляет статус своих задач, своя нагрузка)
STK --> U3
STK --> U5
STK --> U6a
STK --> U6b
STK --> U8
STK --> U10
STK --> U11
STK --> U12

@enduml