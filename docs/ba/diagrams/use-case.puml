@startuml
' OnlyPlans — Use Case diagram (v3)
' Роли: Редактор плана (Продакт, Тимлид, БА) — создают и редактируют план;
' Сотрудник — смотрит свои работы; Руководитель/Стейкхолдер — view-only. См. docs/ba/02-user-stories.md
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
' Ровные ортогональные линии вместо диагоналей — понятнее, к какому юзкейсу ведёт стрелка
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 90

actor "Редактор плана\n(Продакт, Тимлид, БА)" as ED
actor "Сотрудник\n(разработчик/аналитик)" as EMP
actor "Руководитель / Стейкхолдер" as STK

rectangle "OnlyPlans" {

  ' Discovery
  usecase "UC-1 Создать инициативу" as U1
  usecase "UC-2 Настроить этапы команды" as U2
  usecase "UC-3 Отследить статусы инициатив" as U3

  ' Delivery / планирование
  usecase "UC-4 Спланировать неделю (delivery)" as U4
  usecase "UC-5 Передвинуть задачу по этапам" as U5
  usecase "UC-7 Настроить пресеты длительностей" as U7

  ' Календарь
  usecase "UC-6a Просмотреть календарный вид" as U6a
  usecase "UC-6b Настроить календарный вид" as U6b

  ' Свимлайны
  usecase "UC-9 Настроить свимлайны по типам" as U9

  ' Нагрузка
  usecase "UC-10 Управлять нагрузкой" as U10

  ' Таймлайн
  usecase "UC-11 Просмотреть таймлайн с вехами" as U11

  ' Поиск
  usecase "UC-12 Искать и фильтровать" as U12

  ' Комментарии
  usecase "UC-13 Оставлять комментарии и видеть историю" as U13

  ' Просмотр
  usecase "UC-8 Просмотреть роадмап (view-only)" as U8

  ' Связи между юзкейсами
  U1 ..> U2 : включает (этапы)
  U4 ..> U7 : включает (пресеты)
  U6b ..> U6a : использует
}

' Редактор плана: все юзкейсы (полный CRUD)
ED --> U1
ED --> U2
ED --> U3
ED --> U4
ED --> U5
ED --> U6a
ED --> U6b
ED --> U7
ED --> U8
ED --> U9
ED --> U10
ED --> U11
ED --> U12
ED --> U13

' Сотрудник: смотрит свои работы (+ статус своих задач, своя нагрузка)
EMP --> U3
EMP --> U5
EMP --> U6a
EMP --> U6b
EMP --> U8
EMP --> U10
EMP --> U11
EMP --> U12
EMP --> U13

' Руководитель / Стейкхолдер: view-only
STK --> U3
STK --> U6a
STK --> U6b
STK --> U8
STK --> U11
STK --> U12

@enduml